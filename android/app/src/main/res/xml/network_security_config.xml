<?xml version="1.0" encoding="utf-8"?>
<!-- The app talks to the user's own laptop on the home Wi-Fi by bare IP (e.g. http://192.168.1.7:8765),
     where a TLS certificate isn't available. Cleartext is allowed; the API's X-API-Key protects the data.
     Known limitation: on an untrusted network, traffic could be read. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
